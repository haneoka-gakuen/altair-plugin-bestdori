{
  "name": "@haneoka/altair-plugin-bestdori",
  "version": "0.1.0",
  "description": "Lifecycle-scoped Bestdori scenario and authoring asset support for Altair",
  "keywords": [
    "altair",
    "bestdori",
    "visual-novel",
    "converter"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-bestdori.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-bestdori/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-bestdori#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./resource-browser": {
      "types": "./dist/resource-browser.d.ts",
      "import": "./dist/resource-browser.js",
      "default": "./dist/resource-browser.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:pack": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package && pnpm run verify:pack",
    "prepack": "pnpm run check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/altair-plugin-adv": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "workspace:*",
    "@haneoka/altair-plugin-adv": "workspace:*",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "prettier": "3.7.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "altair": {
    "pluginApi": 2,
    "kind": "format",
    "capabilities": [
      "assets",
      "diagnostics",
      "format",
      "services"
    ],
    "permissions": [],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  },
  "dependencies": {
    "@haneoka/vega-protocol": "^0.1.0"
  }
}
